# editor
.vscode/
.idea/

# Claude Code local session/tool config — not part of the app
# (`.claude/*`, not `.claude/`, so the negation below can take effect — git will
#  not re-include a file whose parent directory is itself excluded.)
.claude/*
# ...except the shared, project-scoped agent definitions, which ARE part of the
# repo: they encode how documentation is maintained and must survive a clone.
!.claude/agents/

# ad-hoc local debugging scripts — not part of the app
/scratchpad/
/joblevel.mjs
/run_current.mjs
/scratchpad_org.mjs
/siblings.mjs
/verify.mjs

# vercel
.vercel

.vercel

# Production clone tooling (scripts/clone-prod-db.sh)
.env.clone
.db-dumps/

# DEV-ONLY preview harnesses. They read through the UNSCOPED getClientsFromDb(),
# bypassing Clerk and role scoping, so they must never reach a deployment.
# /app/scratch-wf/ predates this and IS tracked — it renders through the
# role-scoped getClients(), so with no session it resolves to empty.
/app/scratch-clients/
/app/scratch-health/
/app/scratch-insights/
/app/scratch-model-editor/
/app/scratch-pulse/
/app/scratch-settings/
/app/scratch-usecases/

# Local design mocks, never served in the app.
/public/*-mock.html
/public/clients-v2.html
/public/clients-lumofy-grouped.html
/public/filters-interactive.html
/public/insight-strip-compare.html
/public/linear-full.html
/public/linear-style-interactive.html

# Production-clone tooling and its env example — carries prod connection shape.
/scripts/clone-prod-db.sh
.env.clone*
.env.local.bak
